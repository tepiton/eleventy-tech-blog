{
	"name": "eleventy-tech-blog",
	"version": "1.0.0",
	"description": "A tech-focused blog template built with Eleventy v3.",
	"type": "module",
	"scripts": {
		"build": "npx @11ty/eleventy",
		"build-nocolor": "cross-env NODE_DISABLE_COLORS=1 npx @11ty/eleventy",
		"start": "npx @11ty/eleventy --serve --quiet --port=8088",
		"debug": "cross-env DEBUG=Eleventy* npx @11ty/eleventy",
		"debugstart": "cross-env DEBUG=Eleventy* npx @11ty/eleventy --serve --quiet",
		"benchmark": "cross-env DEBUG=Eleventy:Benchmark* npx @11ty/eleventy"
	},
	"license": "MIT",
	"engines": {
		"node": "^22.22.2 || ^24.15.0 || >=26.0.0"
	},
	"devDependencies": {
		"@11ty/eleventy": "^3.1.0",
		"@11ty/eleventy-img": "^7.0.0",
		"@11ty/eleventy-navigation": "^1.0.4",
		"@11ty/eleventy-plugin-rss": "^2.0.4",
		"@11ty/eleventy-plugin-syntaxhighlight": "^5.0.1",
		"cross-env": "^7.0.3",
		"luxon": "^3.6.1",
		"markdown-it-footnote": "^4.0.0",
		"prismjs": "^1.30.0",
		"zod": "^3.24.4",
		"zod-validation-error": "^3.4.1"
	},
	"dependencies": {
		"@kevingimbel/eleventy-plugin-mermaid": "^3.0.0",
		"@zachleat/heading-anchors": "^1.0.3",
		"jsdom": "^30.0.0",
		"mermaid": "^11.6.0"
	},
	"allowScripts": {
		"fsevents@2.3.3": true
	}
}
